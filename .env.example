# Copiar a .env.local. Este archivo contiene nombres y ejemplos, nunca secretos reales.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Para desarrollo local. En Vercel usar una URL libsql:// remota y su token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Privados, solo servidor. Vacío => acceso de servicio/admin deshabilitado.
COLLECTOR_SECRET=
ADMIN_USER_ID=

# Solo para recolectores: mismo secreto que COLLECTOR_SECRET del servidor.
PLAY_METRIC_URL=https://play-metric-vercel.vercel.app
PLAY_METRIC_SERVICE_TOKEN=
